---
import Layout from '../layouts/Layout.astro';
import GridFigure from './GridFigure.astro';
import {getPastPapers,topicLabel} from '../lib/catalog.js';
import {examGroups,examNames} from '../lib/exams.js';
import esat from '../data/practice-esat.json';
import tara from '../data/tara-originals.json';
const {lang='en'} = Astro.props;
const zh = lang === 'zh';
const root = zh ? '/zh' : '';
const papers = getPastPapers();
const counts = new Map();
for (const {exam,year,questions} of papers) {
  const row = counts.get(exam) || {editions:0,questions:0,from:year,to:year};
  row.editions++; row.questions += questions.length;
  row.from = Math.min(row.from,year); row.to = Math.max(row.to,year);
  counts.set(exam,row);
}
const practiceExams = {
  ESAT: {path:'/esat/',summary:zh?esat.length+' 套官方样题和练习':'Official samples & practice · '+esat.length+' tests'},
  TARA: {path:'/tara/',summary:zh?'官方样题 · '+tara.length+' 道站内原创练习':'Official samples · '+tara.length+' original questions'},
};
const groups = examGroups.map(group=>({...group, exams: group.exams.filter(exam=>counts.has(exam) || practiceExams[exam])}));
const featuredTopics = ['algebra','geometry','counting','number-theory','logic','calculus','probability','mechanics'];
---
<Layout lang={lang} current="home" title={zh?'首页':'Home'}>
  <div class="shell">
    <section class="home-hero">
      <div class="hero-text">
        <h1>{zh?'数学真题库':'Mathematics Question Bank'}</h1>
        <p>{zh?'按考试和年份查阅历年真题，或按知识点跨试卷选题，组成自己的练习卷。':'Explore past mathematics questions by exam and year, or choose a topic and build your own worksheet.'}</p>
        <div class="btnrow">
          <a class="button" href={root+'/past-papers/'}>{zh?'浏览历年真题':'Browse past papers'}</a>
          <a class="button light" href={root+'/topics/'}>{zh?'按知识点查题':'Browse by topic'}</a>
        </div>
        <a class="section-link" href={root+'/past-papers/?reading=full'}>{zh?'查看可在站内阅读全文的真题':'Explore papers with full question text'}</a>
      </div>
      <a class="feature-card" href={root+'/problems/count-detour/'}>
        <figure><GridFigure zh={zh} /><figcaption><span class="fig-title">{zh?'绕开封闭路口':'Around a closed intersection'}</span><span class="fig-type">{zh?'原创练习 · 组合计数':'Original practice · Counting'}</span></figcaption></figure>
      </a>
    </section>
    <section class="home-section"><div class="section-top"><h2>{zh?'按考试找题':'Browse by exam'}</h2><a class="section-link" href={root+'/past-papers/'}>{zh?'全部试卷':'All papers'}</a></div>
      {groups.map(group=><div class="exam-group"><h3>{zh?group.zh:group.en}</h3><div class="paper-family">
        {group.exams.map(exam=>{
          const stats=counts.get(exam);
          const practice=practiceExams[exam];
          return <a class="course-tile" href={root+(practice?practice.path:'/past-papers/?exam='+encodeURIComponent(exam))}>
            <h4>{exam}</h4>
            {examNames[exam] && <div class="exam-full-name">{examNames[exam][zh?1:0]}</div>}
            {practice ? <p>{practice.summary}</p> : <>
              <small>{stats.from}–{stats.to}</small>
              <p>{zh?stats.editions+' 份试卷 · '+stats.questions.toLocaleString('en-US')+' 道题':stats.editions+' papers · '+stats.questions.toLocaleString('en-US')+' questions'}</p></>}
          </a>;
        })}
      </div></div>)}
    </section>
    <section class="home-section"><div class="section-top"><h2>{zh?'按知识点找题':'Browse by topic'}</h2><a class="section-link" href={root+'/topics/'}>{zh?'全部专题':'All topics'}</a></div>
      <div class="topic-links">{featuredTopics.map(t=><a href={root+'/topics/?topic='+t}>{topicLabel(t,lang)}</a>)}</div>
    </section>
  </div>
</Layout>
