---
import Layout from '../layouts/Layout.astro';
import originals from '../data/tara-originals.json';
import modules from '../data/tara-modules.json';
import guide from '../data/tara-guide.json';
import legacy from '../data/tara-legacy.json';
import '../styles/archive.css';

const {lang='en'} = Astro.props;
const zh = lang === 'zh';
const t = (en:string, cn:string) => zh ? cn : en;
const prefix = zh ? '/zh' : '';
const title = t('TARA question bank','TARA 题库');
const intro = t('Test of Academic Reasoning for Admissions','学术推理入学考试（Test of Academic Reasoning for Admissions）');
const guideReader = (id:string) => prefix + '/tara/guide/' + id + '/';
---
<Layout title={title} description={intro} current="past" lang={lang}>
  <article class="shell archive-shell tara-bank">
    <nav class="breadcrumb" aria-label={t('Breadcrumb','当前位置')}><a href={prefix+'/past-papers/'}>{t('Past papers','历年真题')}</a> / TARA</nav>
    <header class="archive-hero">
      <h1>{title}</h1>
      <p>{intro}</p>
    </header>

    <section aria-labelledby="originals" class="tara-section tara-first">
      <div class="section-heading">
        <h2 id="originals">{t('Original practice questions','站内原创练习')}</h2>
        <a href={prefix+'/problems/?kind=practice&exam=TARA'}>{t('Build a TARA worksheet','选择 TARA 题目组卷')}</a>
      </div>
      <p>{t('Open a question to read it, reveal the worked approaches or add it to a worksheet.','点击题目可在站内阅读、展开参考解法，或将题目加入自己的试卷。')}</p>
      <div class="tara-grid">
        {modules.map(module=><section id={module.id} class="tara-module">
          <h3>{t(module.title,module.titleZh)}</h3>
          <p class="module-format">{module.id==='writing-task' ? t('In the exam, choose 1 of 3 prompts · 40 min · up to 750 words','正式考试三选一 · 40 分钟 · 最多 750 个英文单词') : t('22 multiple-choice questions in the exam · 40 min','正式考试共 22 道选择题 · 40 分钟')}</p>
          <ul class="question-list">{originals.filter(question=>question.module===module.id).map(question=>
            <li><a href={prefix+'/problems/'+question.id+'/'}>{t(question.titleEn,question.title)}</a></li>
          )}</ul>
        </section>)}
      </div>
    </section>

    <section aria-labelledby="guide" class="tara-section">
      <h2 id="guide">{t('Official worked examples','官方例题')}</h2>
      <p>{t('Read each example in brief, then open our worked explanations or sample writing responses here.','点击查看官方例题的题意概述，再在站内展开解法或写作范例。')}</p>
      <div class="tara-grid">{modules.map(module=><section class="guide-module">
        <h3>{t(module.title,module.titleZh)}</h3>
        <ul class="guide-list">{guide.questions.filter(q=>q.module===module.id).map(q=>{
          const label=t(q.label,q.labelZh);
          return <li><a href={guideReader(q.id)}>{label}</a>
            <a class="answer-link" href={guideReader(q.id)+'#method-1'} aria-label={label+' · '+t('On-site commentary','站内解析')}>{q.module==='writing-task' ? t('Sample responses','写作范例') : t('Worked answer','站内解析')}</a>
          </li>;
        })}</ul>
      </section>)}</div>
    </section>

    <section aria-labelledby="pearson" class="tara-section">
      <h2 id="pearson">{t('Official practice tests','官方机考练习')}</h2>
      <p>{t('Pearson offers two practice sets, each split into three modules. Each link opens the external Pearson exam player in a new tab. Use a desktop computer.','培生发布了两套备考测试，每套分为三个模块。以下入口将在新标签页打开培生外站的机考界面，建议使用电脑。')}</p>
      <table class="pearson-tests">
        <thead><tr><th scope="col">{t('Module','模块')}</th><th scope="col">{t('Specimen test','官方样题')}</th><th scope="col">{t('Practice test','模拟练习')}</th></tr></thead>
        <tbody>{modules.map(module=><tr>
          <th scope="row">{t(module.title,module.titleZh)}</th>
          <td><a href={module.specimenURL} target="_blank" rel="external noopener" aria-label={t(module.title+' specimen test',module.titleZh+'官方样题')}>{t('Open specimen','打开样题')}</a></td>
          <td><a href={module.practiceURL} target="_blank" rel="external noopener" aria-label={t(module.title+' practice test',module.titleZh+'模拟练习')}>{t('Open practice','打开练习')}</a></td>
        </tr>)}</tbody>
      </table>
      <a class="reference" href="https://www.pearsonvue.com/us/en/uatuk.html" target="_blank" rel="external noopener">{t('Pearson VUE test directory (external)','培生官方测试目录（外站）')}</a>
    </section>

    <section aria-labelledby="related" class="tara-section">
      <h2 id="related">{t('Related BMAT and TSA papers','相关考试历年卷 · BMAT 与 TSA')}</h2>
      <p>{t('UAT-UK recommends these earlier tests for additional practice in critical thinking and problem solving. The papers and answer keys below open as external PDFs in a new tab.','UAT-UK 推荐使用以下考试的历年卷补充练习批判性思维与问题解决。以下试卷、答案表和解析为官方 PDF，点击将在新标签页打开外站文件。')}</p>
      {['BMAT','TSA'].map(exam=>{
        const entries=legacy.filter(p=>p.exam===exam).sort((a,b)=>b.year-a.year);
        return <details class="legacy-index">
          <summary>{exam} {t('Section 1','第一部分')} · {entries.at(-1)?.year}–{entries[0]?.year}</summary>
          <ul class="legacy-papers">{entries.map(p=><li>
            <a href={p.url} target="_blank" rel="external noopener">{p.year} {p.exam} · {t('Question paper','试卷')}</a>
            <a href={p.solutionsUrl} target="_blank" rel="external noopener" aria-label={p.year+' '+p.exam+' · '+t('Answer key','答案表')}>{t('Answer key','答案表')}</a>
            {p.explainedUrl && <a href={p.explainedUrl} target="_blank" rel="external noopener" aria-label={p.year+' '+p.exam+' · '+t('Worked answers','解析')}>{t('Worked answers','解析')}</a>}
          </li>)}</ul>
        </details>;
      })}
      <a class="reference" href="https://esat-tmua.ac.uk/tara-preparation-materials/" target="_blank" rel="external noopener">{t('UAT-UK preparation archive (external)','UAT-UK 官方备考档案（外站）')}</a>
    </section>
  </article>
</Layout>
<style>
  .tara-bank { max-width: 66rem; }
  .tara-section { margin: 0 0 clamp(2rem, 4vw, 3.25rem); }
  .tara-section h2 { margin: 0; font: 550 var(--section-size)/1.35 var(--heading); }
  .tara-section h3 { margin: 0 0 .3rem; font: 550 var(--subhead-size)/1.4 var(--heading); }
  .tara-section > p { margin: .4rem 0 1rem; color: var(--muted); max-width: 72ch; }
  .section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; }
  .section-heading a, .reference, .answer-link { color: var(--accent); font-weight: 550; }
  .section-heading a { font-size: .9375rem; }
  .tara-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem clamp(1rem, 2.3vw, 2rem); }
  .tara-module, .guide-module { min-width: 0; border-top: 1px solid var(--navy); padding-top: .8rem; }
  .module-format { margin: .12rem 0 .55rem; color: var(--muted); font-size: .875rem; line-height: 1.55; }
  .question-list, .guide-list, .legacy-papers { list-style: none; margin: 0; padding: 0; }
  .tara-section a { text-underline-offset: .2em; overflow-wrap: anywhere; }
  .question-list li, .guide-list li { border-bottom: 1px solid var(--line); }
  .question-list a, .guide-list a:first-child {
    display: inline-block;
    padding-block: .45rem;
    color: var(--ink);
    font: 500 1.0625rem/1.45 var(--serif);
    text-decoration: none;
  }
  .question-list a:hover, .guide-list a:first-child:hover { color: var(--accent); text-decoration: underline; }
  .answer-link { display: inline-block; font-size: .875rem; margin-inline-start: .5rem; }
  .pearson-tests {
    width: 100%;
    max-width: 53rem;
    border-collapse: collapse;
    border-top: 1px solid var(--navy);
    margin: 1rem 0 .5rem;
  }
  .pearson-tests th, .pearson-tests td { padding: .55rem .65rem .55rem 0; text-align: start; border-bottom: 1px solid var(--line); vertical-align: top; }
  .pearson-tests thead th { color: var(--muted); font: 600 .875rem/1.5 var(--sans); }
  .pearson-tests tbody th { font: 550 1.0625rem/1.5 var(--heading); }
  .pearson-tests td a { color: var(--navy); }
  .reference { display: inline-block; font-size: .9rem; margin-top: .35rem; }
  .legacy-papers li { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  @media (max-width: 700px) {
    .tara-grid { grid-template-columns: 1fr; gap: 1.35rem; }
    .pearson-tests th, .pearson-tests td { padding-inline-end: .35rem; }
    .pearson-tests { font-size: .9375rem; }
  }
</style>
