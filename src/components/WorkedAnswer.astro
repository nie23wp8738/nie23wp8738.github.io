---
import TypesetText from './TypesetText.astro';
import { methodTopicKey } from '../lib/answers.js';
import '../styles/solutions.css';
const { answer, lang, id, sourceUrl, original=false } = Astro.props;
const zh = lang === 'zh';
const t = (en,cn) => zh ? cn : en;
const topicHref = (en) => (zh ? '/zh' : '') + '/topics/methods/?' + new URLSearchParams({topic:methodTopicKey(en)});
---
<section class="worked-answer" aria-label={t('Answers and methods','答案与解法')}>
  <details id="solutions" class="answer-panel">
    <summary>{t('Show answer and methods','查看答案与解法')} <span class="method-count">{t(answer.methods.length+' methods',answer.methods.length+' 种解法')}</span></summary>
    <div class="answer-result">
      <h2>{t('Answer','答案')}</h2>
      {original ? <p>{t(answer.answer,answer.answerZh)}</p> : <TypesetText id={id} text={t(answer.answer,answer.answerZh)} />}
    </div>
    {answer.methods.map((method,index) => <details class="method-panel" id={'method-'+(index+1)}>
      <summary><span class="method-number">{t('Method '+(index+1),'解法 '+(index+1))}</span> {t(method.title,method.titleZh)}</summary>
      <div class="method-content">
        <div class="method-topics"><strong>{t('Topics used','本解法用到的知识点')}</strong>
          {method.topics.map(topic => <a href={topicHref(topic.en)}>{t(topic.en,topic.zh)}</a>)}
        </div>
        {t(method.steps,method.stepsZh).map(step => original ? <p>{step}</p> : <TypesetText id={id} text={step} />)}
        {method.credit && <p class="solution-credit">{t('Adapted from the solution by ','依据以下作者的解法整理：')}{method.credit}{sourceUrl && <> · <a href={sourceUrl}>{t('Published solution','已发表解答')}</a></>}</p>}
      </div>
    </details>)}
  </details>
</section>
<script>
  function openRequestedSolution() {
    const id = window.location.hash.slice(1);
    if (!/^(solutions|method-[1-9][0-9]*)$/.test(id)) return;
    const target = document.getElementById(id);
    const panel = document.querySelector<HTMLDetailsElement>('.worked-answer #solutions');
    if (!(target instanceof HTMLDetailsElement) || !panel) return;
    panel.open = true;
    target.open = true;
    requestAnimationFrame(() => target.scrollIntoView({block:'start'}));
  }
  openRequestedSolution();
  window.addEventListener('hashchange',openRequestedSolution);
</script>
