---
import problems from '../data/problems.json';
import '../styles/bank.css';

const unique = (values: string[]) => [...new Set(values)];
const filters = [
  { name: 'exam', label: '考试', options: unique(problems.flatMap(p => p.exam)) },
  { name: 'topic', label: '知识点', options: unique(problems.map(p => p.topic)) },
  { name: 'method', label: '解题方法', options: unique(problems.map(p => p.method)) },
  { name: 'level', label: '难度', options: ['基础', '提高', '挑战'].filter(v => problems.some(p => p.level === v)) },
];
---
<div class="bank" data-bank>
  <div id="bank-browser" class="bank-browser">
    <div class="bank-topline">
      <h2>查找习题</h2>
      <a class="bank-jump" href="#worksheet">我的试卷（<span data-mobile-count>0</span>）</a>
    </div>
    <form class="bank-filters" data-filters role="search">
      <label class="bank-search">
        <span>搜索</span>
        <input name="q" type="search" placeholder="输入题名、关键词或英文题干" autocomplete="off" />
      </label>
      <div class="bank-filter-grid">
        {filters.map(filter => (
          <label><span>{filter.label}</span>
            <select name={filter.name}>
              <option value="">全部</option>
              {filter.options.map(value => <option value={value}>{value}</option>)}
            </select>
          </label>
        ))}
      </div>
    </form>
    <div class="bank-result-bar">
      <span data-results aria-live="polite">共 {problems.length} 道题</span>
      <button type="button" class="bank-text-button" data-reset hidden>清除筛选</button>
    </div>
    <div class="bank-list">
      {problems.map(problem => (
        <article class="bank-card" data-problem={problem.id}>
          <div class="bank-card-meta">
            <span>{problem.exam.join(' / ')}</span>
            <span>{problem.topic}</span>
            <span>{problem.level}</span>
          </div>
          <h3><a href={'/problems/' + problem.id + '/'}>{problem.title}</a></h3>
          <p lang="en">{problem.statement}</p>
          <div class="bank-card-foot">
            <span>{problem.method}</span>
            <button type="button" data-add={problem.id} aria-pressed="false">加入试卷</button>
          </div>
        </article>
      ))}
    </div>
    <p class="bank-no-results" data-none hidden>没有找到符合条件的题目。可以减少筛选条件，或换一个关键词。</p>
    <noscript><p>题目详情可以直接浏览。要使用筛选和组卷功能，请启用浏览器的 JavaScript。</p></noscript>
  </div>
  <aside class="bank-sheet" id="worksheet" aria-labelledby="worksheet-heading">
    <div class="bank-sheet-heading">
      <h2 id="worksheet-heading">我的试卷</h2>
      <span data-sheet-count>0 道题</span>
    </div>
    <p class="bank-empty" data-empty>点击题目旁的「加入试卷」，在这里调整顺序并下载。</p>
    <ol class="bank-selected" data-selected aria-label="试卷题目顺序"></ol>
    <div class="bank-sheet-actions" data-sheet-actions hidden>
      <button type="button" class="bank-text-button" data-clear>清空试卷</button>
    </div>
    <fieldset class="bank-layout">
      <legend>试卷排版</legend>
      <label><input name="paper-layout" type="radio" value="spaced" checked /> 一题一页</label>
      <label><input name="paper-layout" type="radio" value="compact" /> 紧凑排版</label>
    </fieldset>
    <div class="bank-downloads">
      <button type="button" class="bank-download-main" data-pdf="questions" disabled>下载题目卷 PDF</button>
      <button type="button" class="bank-download-alt" data-pdf="solutions" disabled>下载解析卷 PDF</button>
    </div>
    <p class="bank-live" role="status" aria-live="polite" data-status></p>
    <a class="bank-jump bank-back" href="#bank-browser">返回题目列表</a>
  </aside>
  <script type="application/json" data-problem-data set:html={JSON.stringify(problems).replace(/</g, '\\u003c')} />
</div>
<script type="module" src="/bank.js" is:inline></script>
