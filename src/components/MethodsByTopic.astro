---
import Layout from '../layouts/Layout.astro';
import practice from '../lib/practice.js';
import guide from '../data/tara-guide.json';
import guideNotes from '../data/tara-guide-notes.json';
import { getPastPapers,localPractice } from '../lib/catalog.js';
import { getWorkedAnswer,originalAnswer,methodTopicKey } from '../lib/answers.js';
import { getPublishedOutline } from '../lib/published.js';
const {lang='en'} = Astro.props;
const zh=lang==='zh', root=zh?'/zh':'';
const t=(en,cn)=>zh?cn:en;
const topics=new Map();
const rows=[];
function addMethod(methodTopics, title, question, path) {
  const keys = methodTopics.map(topic=>{
    const key=methodTopicKey(topic.en);
    if (!topics.has(key)) topics.set(key,t(topic.en,topic.zh));
    return key;
  });
  rows.push({keys,title,question,href:root+path});
}
function addMethods(answer, question, path) {
  answer.methods.forEach((method,i)=>{
    addMethod(method.topics,t(method.title,method.titleZh),question,path+'#method-'+(i+1));
  });
}
for (const paper of getPastPapers()) for (const question of paper.questions) {
  if (!question.hasWorkedSolution && !question.outlinePdf) continue;
  const id=paper.id+'-q'+question.n;
  const title=(['STEP','TMUA'].includes(paper.exam) ? paper.year+' '+paper.exam+' · ' : '')+paper.label+t(' · Question ',' · 第 ')+question.n+t('',' 题');
  const path='/questions/'+id+'/';
  if (question.hasWorkedSolution) addMethods(getWorkedAnswer(id),title,path);
  else addMethod(getPublishedOutline(id).topics,t('Worked solution','详细解法'),title,path+'#solutions');
}
for (const q of guide.questions) addMethods(guideNotes[q.id],t(q.label,q.labelZh),'/tara/guide/'+q.id+'/');
for (const p of practice) addMethods(originalAnswer(p),localPractice(p,lang).title,'/problems/'+p.id+'/');
const options=[...topics].sort((a,b)=>a[1].localeCompare(b[1],zh?'zh-CN':'en'));
---
<Layout lang={lang} current="topics" title={t('Solution methods by topic','按知识点找解法')}>
  <article class="shell question method-index">
    <nav class="breadcrumb" aria-label={t('Breadcrumb','当前位置')}><a href={root+'/topics/'}>{t('Topics','知识点')}</a></nav>
    <h1>{t('Solution methods by topic','按知识点找解法')}</h1>
    <form class="method-search" data-method-filter><label>{t('Topic used in the solution','解法用到的知识点')}
      <select name="topic"><option value="">{t('All topics','全部知识点')}</option>{options.map(([key,name])=><option value={key}>{name}</option>)}</select>
    </label></form>
    <p role="status" aria-live="polite" data-method-count></p>
    <ul data-method-list>{rows.map(row=><li data-keys={JSON.stringify(row.keys)}><a href={row.href}>{row.title}</a><span>{row.question}</span></li>)}</ul>
  </article>
</Layout>
<style>
  .method-index { max-width: 48rem; }
  .method-search label { display: grid; gap: .35rem; margin: 1.1rem 0; width: min(100%, 30rem); font: 600 .875rem/1.5 var(--sans); }
  .method-search select {
    max-width: 100%;
    min-height: 2.75rem;
    padding: .45rem .7rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink);
    background-color: var(--paper);
    font: 400 1rem/1.5 var(--sans);
  }
  .method-index [role=status] { color: var(--muted); font-size: .9rem; }
  .method-index ul { list-style: none; padding: 0; margin: .65rem 0 0; border-top: 1px solid var(--navy); }
  .method-index li { margin: 0; padding: .65rem 0; border-bottom: 1px solid var(--line); }
  .method-index li a { color: var(--navy); font: 550 var(--subhead-size)/1.4 var(--heading); text-underline-offset: .2em; }
  .method-index li span { display: block; margin-top: .1rem; color: var(--muted); font-size: .875rem; }
</style>
<script>
  const select=document.querySelector<HTMLSelectElement>('[data-method-filter] select');
  const status=document.querySelector('[data-method-count]');
  if(select && status){
    const rows=[...document.querySelectorAll<HTMLElement>('[data-method-list] li')].map(node=>({node,keys:JSON.parse(node.dataset.keys!)}));
    const zh=document.documentElement.lang.startsWith('zh');
    function show(value:string) {
      select!.value=value;
      let count=0;
      for(const {node,keys} of rows){node.hidden=!!select!.value&&!keys.includes(select!.value); if(!node.hidden)count++;}
      status!.textContent=zh?count+' 种解法':count+(count===1?' method':' methods');
    }
    const readURL=()=>show(new URLSearchParams(location.search).get('topic')||'');
    select.addEventListener('change',()=>{
      const url=new URL(location.href);
      if(select.value)url.searchParams.set('topic',select.value);else url.searchParams.delete('topic');
      history.replaceState(null,'',url);
      window.dispatchEvent(new Event('bank:urlchange'));
      show(select.value);
    });
    window.addEventListener('popstate',readURL);
    readURL();
  }
</script>
