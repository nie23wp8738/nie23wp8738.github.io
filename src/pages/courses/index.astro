---
import Layout from '../../layouts/Layout.astro';
import lessons from '../../data/lessons.json';
import '../../styles/courses.css';
---
<Layout title="课程与讲义" current="courses">
  <div class="course-shell">
    <header class="course-hero">
      <h1>课程与讲义</h1>
      <p>按考试选择专题，在线阅读例题，下载英文讲义，再用配套题库练习。</p>
    </header>
    <section class="course-list" aria-label="专题课程列表">
      {lessons.map(lesson => (
        <article class="course-item">
          <div class="course-field">{lesson.track}</div>
          <div class="course-info">
            <h2><a href={'/courses/' + lesson.slug + '/'}>{lesson.title}</a></h2>
            <p>{lesson.summary}</p>
            <div class="course-meta">{lesson.field}<span aria-hidden="true">·</span>3 个例题<span aria-hidden="true">·</span>英文 PDF</div>
          </div>
          <div class="course-actions">
            <a class="course-btn" href={'/courses/' + lesson.slug + '/'} aria-label={'进入专题：' + lesson.title}>进入专题</a>
            <a class="course-textlink" href={'/handouts/' + lesson.slug + '.pdf'} download aria-label={'下载英文讲义：' + lesson.title}>下载讲义</a>
          </div>
        </article>
      ))}
    </section>
  </div>
</Layout>
