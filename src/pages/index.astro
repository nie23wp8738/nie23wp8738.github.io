---
import Layout from '../layouts/Layout.astro';
import problems from '../data/problems.json';
import lessons from '../data/lessons.json';
const topics = [...new Set(problems.map(p => p.topic))];
const segment = (x:number,y:number,dx:number,dy:number) => 'left:'+x*20+'%;top:'+(100-y*25)+'%;width:'+(dx?dx*20+'%':'3px')+';height:'+(dy?dy*25+'%':'3px');
const lines = [[0,0,2,0],[2,1,0,1],[2,1,1,0],[3,3,0,2],[3,3,2,0],[5,4,0,1]];
---
<Layout title="首页" current="home">
  <div class="shell">
    <section class="home-hero">
      <div class="hero-text">
        <h1><span class="hero-name" lang="en">DR.WANG</span><br />数学教室</h1>
        <p>数学竞赛与英国大学入学考试的专题讲义和原创习题。按知识点练习，也可以挑选题目，组成自己的练习卷。</p>
        <div class="btnrow"><a class="button" href="/problems/">进入分类题库</a><a class="button light" href="/courses/">浏览课程讲义</a></div>
      </div>
      <a class="feature-card" href="/problems/count-detour/" aria-label="打开习题：绕开封闭路口">
        <figure>
          <div class="figure-face" role="img" aria-label="从 (0,0) 到 (5,4) 的格线路径，示例路线绕开了 (2,2)">
            <div class="grid-drawing" aria-hidden="true">
              {Array.from({length:6},(_,i)=><i class="grid-line v" style={'left:'+i*20+'%'} />)}
              {Array.from({length:5},(_,i)=><i class="grid-line h" style={'top:'+i*25+'%'} />)}
              {Array.from({length:30},(_,i)=><i class="node" style={'left:'+(i%6)*20+'%;top:'+Math.floor(i/6)*25+'%'} />)}
              {lines.map(([x,y,dx,dy])=><i class="route-line" style={segment(x,y,dx,dy)} />)}
              <i class="route-marker" style="left:0;top:100%"></i><i class="route-marker" style="left:100%;top:0"></i><span class="blocked">×</span>
              <span class="route-label" style="right:100%;top:100%;margin-right:4px">(0, 0)</span><span class="route-label" style="left:100%;bottom:100%;margin-left:4px">(5, 4)</span>
            </div>
          </div>
          <figcaption><span class="fig-title">绕开封闭路口</span><span class="fig-type">格点路径 · 组合计数</span></figcaption>
        </figure>
      </a>
    </section>
    <section class="home-section"><div class="section-top"><h2>课程与讲义</h2><a class="section-link" href="/courses/">全部课程</a></div>
      <div class="home-courses">{lessons.map(({track:exam,title,summary:desc,slug})=><a class="course-tile" href={'/courses/'+slug+'/'}><span class="course-code" lang="en">{exam}</span><h3>{title}</h3><p>{desc}</p></a>)}</div>
    </section>
    <section class="home-section"><div class="section-top"><h2>按知识点找题</h2><a class="section-link" href="/problems/#worksheet">我的试卷</a></div><div class="topic-links">{topics.map(t=><a href={'/problems/?topic='+encodeURIComponent(t)}>{t}</a>)}</div></section>
  </div>
</Layout>
