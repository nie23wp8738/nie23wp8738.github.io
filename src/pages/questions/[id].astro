---
import PastQuestion from '../../components/PastQuestion.astro';
import { getInlineQuestions } from '../../lib/inline-editions.js';
export function getStaticPaths() {
  return getInlineQuestions().map(record => ({params:{id:record.id}, props:{record}}));
}
const {record} = Astro.props;
---
<PastQuestion lang="en" record={record} />
