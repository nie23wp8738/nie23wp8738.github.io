---
import PastQuestion from '../../../components/PastQuestion.astro';
import Commentary from '../../../components/Commentary.astro';
import { getReadingPaths } from '../../../lib/catalog.js';
export function getStaticPaths() { return getReadingPaths(); }
const {record, paperId, number} = Astro.props;
---
{record ? <PastQuestion lang="zh" record={record} /> : <Commentary lang="zh" paperId={paperId} number={number} />}
