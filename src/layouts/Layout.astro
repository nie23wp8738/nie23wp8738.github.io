---
import '../styles/global.css';
const { title, current = '', description = 'DR.WANG 的数学课程、专题讲义与分类习题。' } = Astro.props;
const nav = [
  {id:'home',name:'首页',url:'/'}, {id:'courses',name:'课程讲义',url:'/courses/'},
  {id:'problems',name:'分类题库',url:'/problems/'}, {id:'about',name:'关于老师',url:'/about/'}
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#192c45" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === '首页' ? 'DR.WANG 数学教室' : title + ' · DR.WANG 数学教室'}</title>
  </head>
  <body>
    <a class="skip" href="#main-content">跳至正文</a>
    <header class="mast"><div class="shell mast-in">
      <a class="brand" href="/" aria-label="DR.WANG 数学教室首页"><span class="brand-mark" aria-hidden="true">W</span><span>DR.WANG <span class="brand-small">数学教室</span></span></a>
      <nav class="topnav" aria-label="主导航">{nav.map(n => <a href={n.url} aria-current={n.id === current ? 'page' : undefined}>{n.name}</a>)}</nav>
    </div></header>
    <main id="main-content"><slot /></main>
    <footer class="footer"><div class="shell footer-in"><a href="/" class="foot-brand">DR.WANG 数学教室</a><div><a href="/courses/">课程讲义</a><a href="/problems/">分类题库</a><a href="/about/">关于老师</a></div></div></footer>
  </body>
</html>
